{
  "name": "connector-fixture-story-skill",
  "version": "0.1.0",
  "description": "Render connector fixture bundles as dry-run review stories for agents.",
  "type": "module",
  "bin": {
    "connector-fixture-story-skill": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/cli.js",
    "smoke": "node src/cli.js fixtures/connector-fixture.json --format markdown",
    "build": "npm run check && npm test",
    "lint": "npm run check",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent",
    "connector",
    "fixtures",
    "dry-run",
    "skill"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "docs",
    "fixtures",
    "examples",
    "SKILL.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-fixture-story-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-fixture-story-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-fixture-story-skill#readme"
}
